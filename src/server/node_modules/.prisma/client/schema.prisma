// Schema do SENSUS AGRO — Machine, Alert e Reading (histórico de vibração
// enviado pelo ESP32) + o model User original do boilerplate (mantido,
// mesmo que o front do SENSUS ainda não use login). Rode
// "npx prisma migrate dev --name init" depois de configurar o
// DATABASE_URL no .env — nada disso foi rodado/aplicado ainda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- model original do boilerplate (mantido) ----------
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- models do domínio SENSUS ----------
enum MachineStatus {
  operando
  alerta
  critico
}

enum BeltStatus {
  NORMAL
  ATENCAO
  CRITICO
}

enum AlertLevel {
  atencao
  critico
  resolvido
  info
}

model Machine {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  model     String
  status    MachineStatus @default(operando)
  temp      Float         @default(0)
  tempMax   Float         @default(120)
  vib       Float         @default(0)
  vibMax    Float         @default(5)
  rpm       Float         @default(0)
  oil       Float         @default(0)
  belt      BeltStatus    @default(NORMAL)
  filtro    Int           @default(100)
  horimetro String        @default("0 h")
  updatedAt DateTime      @updatedAt
  createdAt DateTime      @default(now())

  alerts   Alert[]
  readings Reading[]
}

model Alert {
  id        Int        @id @default(autoincrement())
  level     AlertLevel
  label     String
  message   String
  sensor    String
  createdAt DateTime   @default(now())

  machine   Machine @relation(fields: [machineId], references: [id])
  machineId Int
}

// Histórico bruto de cada leitura de vibração enviada pelo ESP32
// (POST /api/vibracao). Serve pra você depois montar o gráfico real do
// Dashboard e os Relatórios (média por dia, por semana, etc.).
model Reading {
  id        Int      @id @default(autoincrement())
  vibracao  Float
  createdAt DateTime @default(now())

  machine   Machine @relation(fields: [machineId], references: [id])
  machineId Int
}
